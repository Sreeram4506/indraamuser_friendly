# ==========================================================================
# Copy to .env.local for local dev, and set the same values in your host's
# dashboard for production (Vercel: Project → Settings → Environment Variables;
# Netlify: Site configuration → Environment variables).
#
# .env.local is gitignored. NEVER commit a real key, and never paste one into
# js/app.js or any file the browser downloads.
# ==========================================================================

# Required — your OpenAI key (starts sk-...). Create it at
# https://platform.openai.com/api-keys and scope it to this project.
OPENAI_API_KEY=

# Optional — model for both the site agent and the gap finder.
OPENAI_MODEL=gpt-4o-mini

# Optional — upstream request timeout in ms.
OPENAI_TIMEOUT_MS=20000

# Strongly recommended in production. Comma-separated list of origins allowed
# to call /api/*. Unset means "allow any origin", which is fine locally but
# lets anyone put your endpoint behind their own site and spend your credit.
# ALLOWED_ORIGINS=https://indraam.com,https://www.indraam.com

# Per-IP limits on the public routes are built in: chat 8/min, 40/hour, 100/day;
# gap finder 3/min, 10/hour, 20/day; contact form 2/min, 5/hour, 15/day. Counters
# live in MongoDB (shared by every serverless instance) when MONGODB_URI is set,
# and in memory otherwise. IPv6 visitors are counted per /64.
#
# Which header holds the visitor's address: on Vercel and Netlify the platform's own
# header is used automatically. Anywhere else the address comes from the connection
# itself, because x-forwarded-for can be written by the caller. Behind your own
# reverse proxy, set TRUST_PROXY=1 to read x-forwarded-for instead.
# TRUST_PROXY=

# Site-wide ceiling on AI calls per day, however many IPs they come from. Past it
# the chat and gap finder show their offline copy until the next day. This is your
# backstop against a bill; it does not replace a spend limit at your AI provider.
AI_DAILY_LIMIT=3000

# Site-wide ceiling on contact form submissions per hour (a flood safety valve).
CONTACT_GLOBAL_PER_HOUR=100

# Optional — older memory-only limiter, used by small public routes.
RATE_WINDOW_MS=60000
RATE_MAX=12

# Optional — where the contact form is delivered. Any URL that accepts a JSON
# POST: a Zapier/Make hook, a Slack incoming webhook, your CRM. Submissions are
# saved to MongoDB and shown in /admin either way, so a missing hook only costs
# you the notification, never the lead.
# CONTACT_WEBHOOK_URL=


# ==========================================================================
# Admin dashboard (/admin) + storage
# ==========================================================================

# MongoDB Atlas connection string. Atlas → Database → Connect → Drivers.
# It contains a username and password, so treat it exactly like the OpenAI key:
# server-side only, never committed, never pasted into a chat window.
#
# Two things to get right in Atlas:
#   • Create a DEDICATED database user for this app with readWrite on one
#     database only — do not reuse an admin/root user.
#   • Network Access → allow 0.0.0.0/0 is required for serverless (the function
#     IP is not stable). That makes the password your only barrier, so make it
#     long and random.
#
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=indraam

# The single password for /admin. Long and random — this is the only thing
# between the internet and every visitor email you've collected.
# Generate one: npm run secret
ADMIN_PASSWORD=

# Signs the admin session cookie. Any random 32+ character string.
# Generate one: npm run secret
# Changing it signs everyone out immediately — that's your panic button.
SESSION_SECRET=

# Optional — how long a signed-in session lasts, in hours. Default 168 (7 days).
ADMIN_SESSION_HOURS=168

# Strongly recommended — a second factor for /admin: the 6-digit code from an
# authenticator app (Google Authenticator, 1Password, Authy...). Run `npm run totp`
# to make a secret and a QR code to scan, then paste the secret here and in Vercel.
# Once set, signing in needs the password AND a current code. A wrong value here
# closes the admin entirely rather than quietly dropping the second factor.
# ADMIN_TOTP_SECRET=

# Optional — sign-in attempts allowed per IP before that IP is locked out for a full
# window. A successful sign-in doesn't count. Defaults: 5 per 15 minutes (900000 ms).
# A value that isn't a positive number is ignored and the default is used.
# ADMIN_LOGIN_MAX=5
# ADMIN_LOGIN_WINDOW_MS=900000

# Certificates — the site address encoded in every certificate's QR code.
# Defaults to https://www.indraam.com. Only change it to test with another host;
# a QR code that has already been printed keeps pointing at whatever it was made with.
PUBLIC_BASE_URL=https://www.indraam.com

# Optional — how many certificate lookups one IP may make per minute on /api/verify. Default 40.
VERIFY_RATE_MAX=40

# ==========================================================================
# Copy to .env.local for local dev, and set the same values in your host's
# dashboard for production (Vercel: Project → Settings → Environment Variables;
# Netlify: Site configuration → Environment variables).
#
# .env.local is gitignored. NEVER commit a real key, and never paste one into
# js/app.js or any file the browser downloads.
# ==========================================================================

# Required — your OpenAI key (starts sk-...). Create it at
# https://platform.openai.com/api-keys and scope it to this project.
OPENAI_API_KEY=

# Optional — model for both the site agent and the gap finder.
OPENAI_MODEL=gpt-4o-mini

# Optional — upstream request timeout in ms.
OPENAI_TIMEOUT_MS=20000

# Strongly recommended in production. Comma-separated list of origins allowed
# to call /api/*. Unset means "allow any origin", which is fine locally but
# lets anyone put your endpoint behind their own site and spend your credit.
# ALLOWED_ORIGINS=https://indraam.com,https://www.indraam.com

# Optional — best-effort per-IP rate limit on the AI routes.
RATE_WINDOW_MS=60000
RATE_MAX=12

# Optional — where the contact form is delivered. Any URL that accepts a JSON
# POST: a Zapier/Make hook, a Slack incoming webhook, your CRM. Submissions are
# saved to MongoDB and shown in /admin either way, so a missing hook only costs
# you the notification, never the lead.
# CONTACT_WEBHOOK_URL=


# ==========================================================================
# Admin dashboard (/admin) + storage
# ==========================================================================

# MongoDB Atlas connection string. Atlas → Database → Connect → Drivers.
# It contains a username and password, so treat it exactly like the OpenAI key:
# server-side only, never committed, never pasted into a chat window.
#
# Two things to get right in Atlas:
#   • Create a DEDICATED database user for this app with readWrite on one
#     database only — do not reuse an admin/root user.
#   • Network Access → allow 0.0.0.0/0 is required for serverless (the function
#     IP is not stable). That makes the password your only barrier, so make it
#     long and random.
#
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=indraam

# The single password for /admin. Long and random — this is the only thing
# between the internet and every visitor email you've collected.
# Generate one: npm run secret
ADMIN_PASSWORD=

# Signs the admin session cookie. Any random 32+ character string.
# Generate one: npm run secret
# Changing it signs everyone out immediately — that's your panic button.
SESSION_SECRET=

# Optional — how long a signed-in session lasts, in hours. Default 168 (7 days).
ADMIN_SESSION_HOURS=168
